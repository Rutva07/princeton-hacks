# Set RESEARCH_MODE=deepagents for real LLM subagent orchestration (requires keys)
RESEARCH_MODE=demo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional general-web tool for the LangChain room bot. Academic search uses OpenAlex without a key.
TAVILY_API_KEY=

# Interchangeable model providers for the autonomous LangGraph.
# Use auto to select the first configured provider, or: openai, openrouter, nvidia, groq, ollama.
RESEARCH_MODEL_PROVIDER=auto
RESEARCH_MODEL=
PLANNING_MODEL_PROVIDER=auto
PLANNING_MODEL=
CODING_MODEL_PROVIDER=auto
CODING_MODEL=
DEBUG_MODEL_PROVIDER=auto
DEBUG_MODEL=
REPORT_MODEL_PROVIDER=auto
REPORT_MODEL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Safe local experiment worker. Docker must be running and the executor image built.
EXPERIMENT_EXECUTOR=docker
EXPERIMENT_IMAGE=labthread-executor:py312
EXPERIMENT_MAX_RUNTIME=300
EXPERIMENT_MEMORY_MB=2048
EXPERIMENT_CPU_CORES=2
EXPERIMENT_PIDS_LIMIT=128
EXPERIMENT_MAX_RETRIES=2
EXPERIMENT_DISK_MB=256
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=labthread-hackprinceton

# Photon 2.0 Beta ONLY. Never use Stable Spectrum credentials.
PHOTON_ENABLED=false
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_POLLING_ENABLED=false
PHOTON_ALLOW_GROUPS=false
PHOTON_POLL_SECONDS=8
PHOTON_PLATFORM=imessage
# Optional inbound sender allowlist, comma separated. Leave blank in local demo.
PHOTON_ALLOWED_SENDERS=

OPENALEX_EMAIL=
DATA_DIR=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
